rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 홈 화면 위젯이 읽는 한 장짜리 요약: 읽기만 열어 둠
    match /families/{fam}/app/widget {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 나머지 가족 기록: 로그인한 기기만
    match /families/{fam}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
